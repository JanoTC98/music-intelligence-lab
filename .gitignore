# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Environments
.venv/
.env

# IDE
.idea/

# Streamlit secrets
.streamlit/secrets.toml

# Jupyter
.ipynb_checkpoints/

# Raw and generated data
data/raw/*
!data/raw/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/*.parquet
!data/processed/*.json

# Models and generated reports
models/**/*.joblib
models/**/*.npy
models/**/*.npz
models/**/*.pkl
# Production artifacts versioned for deployment (AGENTS.md sección 27, Opción A).
# Retraining keeps timestamps; globs match the serving bundle regardless.
!models/recommender/v1/*.joblib
!models/recommender/v1/*.npy
!models/preferences/v1/*.joblib
!models/preferences/v1/*.npy
!models/classifier/multilabel/*_M1_A/model.joblib
!models/classifier/multilabel/*_M1_A/scaler.joblib
!models/classifier/multilabel/*_M1_B/model.joblib
!models/classifier/multilabel/*_M1_B/scaler.joblib
!models/classifier/multiclass/*_C1/model.joblib
!models/classifier/multiclass/*_C1/scaler.joblib
reports/figures/*
reports/experiments/*

# Logs and OS
*.log
.DS_Store
Thumbs.db

# Local distribution output
dist/
