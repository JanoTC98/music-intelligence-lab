{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "share": "disabled",
  "snapshot": true,
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".venv/**",
      "data/raw/**",
      "data/processed/**",
      "models/**",
      "reports/figures/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".ruff_cache/**"
    ]
  },
  "instructions": [
    "AGENTS.md"
  ]
}
