# Copia este archivo como .streamlit/secrets.toml y ajusta los valores.
# No versiones .streamlit/secrets.toml ni contraseñas reales en Git.
# La persistencia de eventos y feedback en MySQL está fuera del alcance; la app funciona sin ella.
TRACKING_ENABLED = "false"
DATABASE_URL = "mysql+pymysql://spotify_app:CAMBIAR_PASSWORD@127.0.0.1:3306/spotify_music_intelligence?charset=utf8mb4"
